# ==============================================================================
# Python (backend/)
# ==============================================================================

# Byte-compiled / optimized / DLL files
backend/**/__pycache__/
backend/**/*.py[codz]
backend/**/*$py.class

# Distribution / packaging
backend/build/
backend/dist/
backend/**/*.egg-info/
backend/**/*.egg

# Virtual environments
backend/.venv/
backend/env/
backend/venv/

# Unit test / coverage reports
backend/htmlcov/
backend/htmlcov-*/
backend/.coverage
backend/.coverage.*
backend/.pytest_cache/
backend/coverage.xml
backend/pytest-results.xml
backend/pytest-results*

# Performance test artifacts (generated by test suites and report scripts)
backend/tests/performance/baseline.json
# Suite-specific baseline (generated by the health_check_worker suite)
backend/tests/performance/audit/PERFORMANCE_REPORT.md
backend/tests/performance/audit/baselines.json
backend/tests/performance/audit/audit-perf-results.xml

# Type checkers
backend/.mypy_cache/
backend/.ruff_cache/

# Secrets
backend/.secrets/

# DAST scan results
backend/dast/results/

# Local Makefile
backend/Makefile.local

# ==============================================================================
# Node.js / TypeScript (frontend/)
# ==============================================================================

frontend/node_modules/
frontend/**/dist/
frontend/**/dist-ssr/
frontend/**/*.local

# Test artifacts
frontend/**/coverage/
frontend/**/coverage.claude/
frontend/**/.c8_output/
frontend/**/test-results/
frontend/**/playwright-report/
frontend/**/visual-diff-summary.json

# macOS visual regression snapshots (Linux baselines are CI source of truth)
frontend/**/page-screenshots.spec.ts-snapshots/**/*-darwin.png

frontend/storybook-static/
frontend/.eslintcache

# ==============================================================================
# Shared
# ==============================================================================

# File upload storage (container bind mount)
data/uploads/

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log

# OS files
.DS_Store

# IDE / Editor
.idea/
.vscode/
.cursor/
.cursorignore
.cursorindexingignore

# AI agent local files — ignore .claude/ contents by default, then selectively un-ignore.
# Policy: executable agent hooks and local settings must not ship publicly
# (see .github/AI_AGENT_POLICY.md). The blanket ignore covers settings.json,
# settings.local.json, hooks/, and other runtime agent config.
.claude/*
!.claude/skills/
!.claude/skills/**
# Exclude skill eval outputs — evals/ holds benchmark results and *-workspace/
# holds per-run iteration artifacts generated by the skill-creator eval harness
.claude/skills/**/evals/
.claude/skills/**/*-workspace/
!.claude/commands/
!.claude/commands/**
CLAUDE.local.md
AGENTS.local.md
.gemini/
worktrees/

# Playwright MCP
.playwright-mcp/

# top-level node_modules directory if it is inadvertently created
node_modules/
