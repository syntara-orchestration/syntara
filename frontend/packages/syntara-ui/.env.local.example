# Copy to .env.local and adjust. Playwright loads .env.local with override (see playwright.config.ts).

# --- Mock API (default): Playwright starts UI :4173 and mock API :3300 ---
SYNTARA_E2E_SKIP_WEB_SERVER=
SYNTARA_E2E_BASE_URL=http://localhost:4173
VITE_API_URL=http://localhost:3300

# --- Real backend: dev server on 5173, API on https://localhost:8000 ---
# SYNTARA_E2E_SKIP_WEB_SERVER=1
# SYNTARA_E2E_BASE_URL=http://localhost:5173
# VITE_API_URL=https://localhost:8000
# SYNTARA_E2E_PASSWORD=
