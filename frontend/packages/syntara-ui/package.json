{
  "name": "@syntara/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist node_modules",
    "start": "concurrently -n app,sb 'vite --open' 'npm run storybook' -c auto",
    "start:e2e": "vite --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "test": "concurrently npm:lint npm:tsc npm:vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:shard": "vitest run --coverage",
    "test:coverage:merge": "node scripts/merge-coverage.js",
    "test:coverage:report": "nyc report --temp-dir .nyc_output --report-dir coverage --reporter html --reporter lcov --reporter json --reporter json-summary --reporter text",
    "e2e": "playwright test",
    "e2e:pr-check": "playwright test --grep @pr-check",
    "e2e:exclude-pr-check": "playwright test --grep-invert @pr-check",
    "e2e:ui": "playwright test --ui",
    "e2e:a11y-audit": "SYNTARA_E2E_A11Y_AUDIT=1 playwright test e2e/a11y-audit --workers=1",
    "vitest": "vitest run",
    "tsc": "concurrently --raw -n app,node,storybook,e2e \"tsc --noEmit -p tsconfig.app.json\" \"tsc --noEmit -p tsconfig.node.json\" \"tsc --noEmit -p tsconfig.storybook.json\" \"tsc --noEmit -p tsconfig.e2e.json\"",
    "lint": "NODE_OPTIONS='--max-old-space-size=8192' eslint .",
    "lint:fix": "NODE_OPTIONS='--max-old-space-size=8192' eslint . --fix",
    "knip": "knip",
    "knip:exports": "knip --include files,exports,duplicates,enumMembers,namespaceMembers",
    "route-baseline:check": "tsx scripts/route-baseline/check-route-baseline.ts",
    "route-baseline:update": "tsx scripts/route-baseline/update-route-baseline.ts",
    "storybook": "storybook dev -p 5174 --exact-port --ci --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.2",
    "@patternfly/react-code-editor": "^6.7.0",
    "@patternfly/react-core": "^6.7.0",
    "@patternfly/react-table": "^6.7.0",
    "@syntara/contracts": "file:../syntara-contracts",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@xyflow/react": "^12.12.1",
    "date-fns": "^4.4.0",
    "fuse.js": "^7.5.0",
    "jmespath": "^0.16.0",
    "js-yaml": "^5.5.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7",
    "zundo": "^2.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.13",
    "@currents/playwright": "2.7.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "^0.3.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-mcp": "^10.6.6",
    "@storybook/tanstack-react": "^10.6.6",
    "@tanstack/eslint-plugin-query": "^5.106.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/jmespath": "^0.15.2",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-barrel-files": "^3.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.11.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-storybook": "^10.6.6",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.14.0",
    "happy-dom": "^20.14.6",
    "knip": "^6.44.1",
    "nyc": "^18.0.0",
    "pngjs": "^7.0.0",
    "prettier": "3.9.10",
    "storybook": "^10.6.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0",
    "vitest-axe": "^1.0.0-pre.5"
  }
}
