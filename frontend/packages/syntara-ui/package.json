{
  "name": "@syntara/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist node_modules",
    "start": "concurrently -n app,sb 'vite --open' 'npm run storybook' -c auto",
    "build": "vite build",
    "preview": "vite preview",
    "test": "concurrently npm:lint npm:tsc npm:vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:shard": "vitest run --coverage",
    "test:coverage:merge": "node scripts/merge-coverage.js",
    "test:coverage:report": "nyc report --temp-dir .nyc_output --report-dir coverage --reporter html --reporter lcov --reporter json --reporter json-summary --reporter text",
    "e2e": "playwright test",
    "e2e:pr-check": "playwright test --grep @pr-check",
    "e2e:exclude-pr-check": "playwright test --grep-invert @pr-check",
    "e2e:ui": "playwright test --ui",
    "vitest": "vitest run",
    "tsc": "concurrently --raw -n app,node,storybook,e2e \"tsc --noEmit -p tsconfig.app.json\" \"tsc --noEmit -p tsconfig.node.json\" \"tsc --noEmit -p tsconfig.storybook.json\" \"tsc --noEmit -p tsconfig.e2e.json\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "knip:exports": "knip --include files,exports,duplicates,enumMembers,namespaceMembers",
    "storybook": "storybook dev -p 5174 --exact-port --ci --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@patternfly/react-code-editor": "^6.6.1",
    "@patternfly/react-core": "^6.6.1",
    "@patternfly/react-table": "^6.6.1",
    "@syntara/contracts": "file:../syntara-contracts",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@xyflow/react": "^12.11.5",
    "date-fns": "^4.4.0",
    "fuse.js": "^7.5.0",
    "jmespath": "^0.16.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "uuid": "^14.0.2",
    "zod": "^4.4.3",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@currents/playwright": "2.5.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jmespath": "^0.15.2",
    "@types/node": "^25.9.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.11.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-storybook": "10.5.10",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "knip": "^6.32.3",
    "nyc": "^18.0.0",
    "pngjs": "^7.0.0",
    "prettier": "3.9.6",
    "storybook": "^10.5.10",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.68.0",
    "vite": "^7.3.6",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.11",
    "vitest-axe": "^1.0.0-pre.5"
  }
}
