{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["src/**/*.{ts,tsx}"],
  "treatConfigHintsAsErrors": false,
  "ignoreDependencies": [
    "@vitest/browser",
    "babel-plugin-react-compiler",
    "eslint",
    "prettier",
    "nyc",
    "tsx",
    "pngjs",
    "@types/pngjs"
  ],
  "ignoreBinaries": ["concurrently", "vitest", "playwright", "tsc", "knip", "eslint", "nyc", "vite", "storybook"],
  "exclude": ["unlisted", "types"]
}
