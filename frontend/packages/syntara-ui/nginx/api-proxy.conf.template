# Proxy backend paths (API, metrics, versioned API docs, /docs redirect)
# Generated at container startup from APP_API_URL environment variable.
# Only present when APP_API_URL is set (dev mode).
# Production proxying is handled by external ingress.
location ~ ^/(api_docs|api|metrics|docs) {
    proxy_pass ${APP_API_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# Proxy WebSocket connections to backend service
location /ws/ {
    proxy_pass ${APP_API_URL};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}
