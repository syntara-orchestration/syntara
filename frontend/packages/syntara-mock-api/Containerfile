# Build stage - use native platform for faster builds
FROM --platform=$BUILDPLATFORM mirror.gcr.io/library/node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS builder

ARG TARGETPLATFORM
ARG BUILDPLATFORM

WORKDIR /app

# Copy package files for all required packages
COPY package*.json ./
COPY packages/syntara-contracts/package*.json ./packages/syntara-contracts/
COPY packages/syntara-mock-api/package*.json ./packages/syntara-mock-api/

# Install dependencies
RUN npm ci --no-fund --ignore-scripts

# Copy source files
COPY packages/syntara-contracts ./packages/syntara-contracts
COPY packages/syntara-mock-api ./packages/syntara-mock-api

# Production stage - target platform will be used automatically
FROM mirror.gcr.io/library/node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53
WORKDIR /app

# Copy package files and install production dependencies
# Note: Explicitly list files instead of wildcards when copying from previous stage
COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/packages/syntara-contracts/package.json ./packages/syntara-contracts/
COPY --from=builder /app/packages/syntara-mock-api/package.json ./packages/syntara-mock-api/

RUN npm ci --omit=dev --no-fund --ignore-scripts

# Copy source code
COPY --from=builder /app/packages/syntara-contracts ./packages/syntara-contracts
COPY --from=builder /app/packages/syntara-mock-api ./packages/syntara-mock-api

# Set working directory to the mock API package
WORKDIR /app/packages/syntara-mock-api

USER node

# Expose the API port
EXPOSE 3000

# Set environment variable for port
ENV PORT=3000

# Run the server
CMD ["npm", "start"]
