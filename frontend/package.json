{
  "name": "syntara",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently npm:start:* -c auto",
    "start:ui": "npm run start --prefix packages/syntara-ui",
    "start:mock-api": "npm run start --prefix packages/syntara-mock-api",
    "build": "npm run build --workspace=packages/syntara-ui",
    "test": "npm run build && concurrently --group npm:test:* npm:format:check -c auto && if [ $? -eq 0 ]; then echo 'All Tests Passed: Success' && exit 0; else echo 'Checks failed: Failure' && exit 1; fi",
    "test:ui": "npm run test --prefix packages/syntara-ui",
    "test:coverage": "npm run test:coverage --prefix packages/syntara-ui",
    "check": "NODE_OPTIONS='--max-old-space-size=8192' concurrently --group -c auto --names 'mermaid,tsc,lint,format,knip' 'npm run lint:mermaid' 'npm run tsc' 'npm run lint' 'npm run format:check' 'npm run knip'",
    "e2e": "npm run e2e --prefix packages/syntara-ui",
    "e2e:ui": "npm run e2e:ui --prefix packages/syntara-ui",
    "e2e:visual-regression": "npm run e2e --prefix packages/syntara-ui -- e2e/visual-regression/page-screenshots",
    "e2e:visual-regression:update": "npm run e2e --prefix packages/syntara-ui -- e2e/visual-regression/page-screenshots --update-snapshots",
    "e2e:visual-regression:container": "bash scripts/visual-regression-container.sh",
    "e2e:visual-regression:container:update": "bash scripts/visual-regression-container.sh --update",
    "check:visual-baselines": "npm exec --prefix packages/syntara-ui tsx -- scripts/check-visual-baselines.ts",
    "knip": "npm run knip --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tsc": "npm run tsc --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "lint:mermaid": "node scripts/lint-mermaid.js",
    "create-workflow": "python3 tools/workflow-creator/create_workflow.py",
    "storybook": "npm run storybook --prefix packages/syntara-ui",
    "storybook:build": "npm run storybook:build --prefix packages/syntara-ui",
    "gen": "npm run gen:local --prefix packages/syntara-contracts",
    "mutate": "npm run mutate --prefix packages/syntara-ui",
    "podman:build": "concurrently npm:podman:build:* -c auto",
    "podman:build:ui": "podman build -f packages/syntara-ui/Containerfile -t syntara-ui:latest -t localhost/syntara-ui:latest .",
    "podman:build:mock-api": "podman build -f packages/syntara-mock-api/Containerfile -t syntara-mock-api:latest -t localhost/syntara-mock-api:latest .",
    "podman:run": "concurrently npm:podman:run:* -c auto",
    "podman:run:ui": "podman run --rm -p 4000:80 --name syntara-ui localhost/syntara-ui:latest",
    "podman:run:mock-api": "podman run --rm -p 3000:3000 --name syntara-mock-api localhost/syntara-mock-api:latest"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "eslint": "^9.39.4",
    "@eslint/js": "^9.39.4",
    "brace-expansion": "5.0.9",
    "dompurify": "3.4.12",
    "js-yaml": "4.3.1",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "minimatch": "10.2.6",
    "path-to-regexp@<1.0.0": "0.1.13",
    "shell-quote": "^1.8.5",
    "valibot": "^1.4.2",
    "vite": "^7.3.5",
    "esbuild": "^0.28.1",
    "istanbul-lib-processinfo": {
      "uuid": "^11.1.1"
    },
    "playwright-core": "1.62.1",
    "playwright": "1.62.1",
    "picomatch": "4.0.4",
    "nanoid": "^3.3.17"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "jsdom": "^29.1.1",
    "mermaid": "^11.16.0",
    "prettier": "3.8.4",
    "vitest": "^4.1.10"
  },
  "os": [
    "darwin",
    "linux",
    "windows"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
