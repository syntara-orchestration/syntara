# ==============================================================================
# Syntara Combined Development Environment Configuration
# ==============================================================================
# Copy this file to .env and customize as needed
# DO NOT commit .env to version control

# ==============================================================================
# Backend Configuration
# ==============================================================================

# PostgreSQL Database Configuration
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=admin
APP_DB_PASSWORD=admin
APP_DB_NAME=syntara_api
APP_DB_POOL_SIZE=10
APP_DB_MAX_OVERFLOW=20
APP_DB_POOL_TIMEOUT_SECONDS=30

# PostgreSQL SSL/TLS Configuration
# APP_DB_SSL_MODE=prefer
# APP_DB_SSL_ROOT_CERT=
# APP_DB_SSL_CERT=
# APP_DB_SSL_KEY=

# Alternative: Full database URL (overrides ALL individual APP_DB_* settings)
# APP_DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/syntara_api

# Temporal Workflow Engine Configuration
APP_TEMPORAL_PORT=7233
APP_TEMPORAL_UI_PORT=8081
APP_TEMPORAL_ADDRESS=localhost:7233
APP_TEMPORAL_NAMESPACE=default
APP_TASK_QUEUE=workflow-queue
APP_MAX_CONCURRENT_WORKFLOWS=0  # Cap on concurrent non-terminal workflow executions (0 = disabled)

# Internal Service-to-Service mTLS Configuration
# Certificates are auto-generated by 'make setup' or 'make certs' into backend/.secrets/certs/
# Enabled by default in podman-compose; disabled for non-compose local dev (make dev)
# Set APP_S2S_TLS_ENABLED=false in your .env to disable TLS in compose
# APP_S2S_TLS_ENABLED=true
# APP_S2S_TLS_CA_CERT_PATH=backend/.secrets/certs/ca.pem
# APP_S2S_TLS_CERT_PATH=backend/.secrets/certs/backend.crt
# APP_S2S_TLS_KEY_PATH=backend/.secrets/certs/backend.key

# Podman Compose Configuration
PODMAN_PROJECT=syntara

# API and Service Ports
APP_API_PORT=8000
APP_UI_PORT=8080
# Downstream branding for podman-compose image builds (build-time args).
# Defaults match Approach 1 / PR #1198. Set BRANDING=false for community assets.
# DOWNSTREAM_OVERRIDE=quay.io/redhat-user-workloads/nexus-tenant/ansible-automation-platform/automation-orchestrator-downstream-override@sha256:af90c3824339a47b1acafb4fd974670d2f17e79826b6b3904615ee6b9891ef77
# BRANDING=true
APP_CACHE_HOST=localhost
APP_CACHE_PORT=6379
APP_CACHE_PASSWORD=cache

# JWT Authentication Configuration
# Run 'make secrets' to create development keys in backend/.secrets/
APP_JWT_PRIVATE_KEY_PATH=backend/.secrets/jwt-primary.pem
APP_JWT_BACKUP_KEYS=[{"key_id":"syntara-backup","key_path":"backend/.secrets/jwt-backup.pem"}]
APP_ADMIN_PASSWORD_PATH=backend/.secrets/admin-password
APP_SECRET_ENCRYPTION_KEY_PATH=backend/.secrets/encryption-key

# Server Configuration
APP_SERVER_SCHEME=http
APP_SERVER_PUBLIC_URL=http://localhost:8000
APP_CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:8080"]
# APP_OIDC_ALLOW_PRIVATE_NETWORKS=false
# APP_CREDENTIAL_ALLOW_HTTP_HOST=false   # Allow HTTP scheme for credential host URLs (enable for local dev cluster)
# APP_SA_CREDENTIAL_MAX_LIFETIME_DAYS=180  # Max lifetime for SA credentials in days (-1 = unlimited, 1-730)

# Logging Configuration
APP_FALLBACK_LOG_LEVEL=INFO

# Telemetry Configuration (Segment.com)
# APP_SEGMENT_WRITE_KEY=
# APP_SEGMENT_ENDPOINT=https://api.segment.io
# APP_ENTITLEMENT_ID=
# APP_COLLECTION_INTERVAL_SECONDS=300

# LLM Provider Configuration (OpenRouter)
APP_OPENROUTER_MODEL=anthropic/claude-sonnet-4
APP_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
APP_OPENROUTER_TEMPERATURE=0.7
APP_OPENROUTER_MAX_TOKENS=1000

# S3-Compatible File Storage (moto defaults for local dev)
APP_S3_ENDPOINT_URL=http://localhost:5555
APP_S3_BUCKET_NAME=syntara-files
APP_S3_REGION=us-east-1
APP_S3_ACCESS_KEY_ID=testing
APP_S3_SECRET_ACCESS_KEY=testing
APP_S3_VERIFY_SSL=false
APP_S3_USE_PATH_STYLE=true

# API Validation
APP_OPENAPI_VALIDATION_ENABLED=true
APP_ROUTER_DISCOVERY_ENABLED=true

# API Documentation Endpoints
# Serve Swagger/ReDoc/OpenAPI at /api_docs/v1/ (plus /docs redirect). Disabled by default for production security.
# Set to true here for local development only — do NOT copy this value to production.
APP_ENABLE_API_DOCS=true
# Enable the Swagger UI "Try it out" button. Defaults to false.
# APP_ENABLE_TRY_IT_OUT=false

# Workflow Engine Configuration
# APP_SCRIPT_CLEANUP_TERMINATE_TIMEOUT=1.0
# APP_SCRIPT_CLEANUP_KILL_TIMEOUT=0.5
# APP_MAX_ENV_VAR_LENGTH=32768

# Service-to-Service Communication URLs (auto-configured in podman-compose.yml)
# APP_WORKFLOW_BASE_URL=http://localhost:8000/api/v1
# APP_AGENT_ORCHESTRATOR_BASE_URL=http://localhost:8000/api/v1
# APP_APPROVALS_API_BASE_URL=http://localhost:8000/api/v1

# AAP (Ansible Automation Platform) Configuration
# APP_AAP_BASE_URL=https://aap.example.com
# APP_AAP_USERNAME=workflow_user
# APP_AAP_PASSWORD=secret_password
# APP_AAP_TOKEN=your_api_token_here
# APP_AAP_VERIFY_SSL=true
# APP_AAP_TIMEOUT_SECONDS=3600
# APP_AAP_POLL_INTERVAL_SECONDS=5.0

# ==============================================================================
# Frontend Configuration
# ==============================================================================

# Frontend Development Ports (when running outside containers)
# UI: http://localhost:5173
# Mock API: http://localhost:3000
# Storybook: http://localhost:5174

# To connect frontend to real backend:
# VITE_API_URL=http://localhost:8000

# Community vs extended build gate (docs URLs, title, optional overlays).
# Unset = community build. Set true/1 in extended builds.
# Legacy VITE_DOC_MODE / VITE_APP_MODE are ignored — use VITE_EXTENDED only.
# VITE_EXTENDED=true

# Backend display name. Defaults to 'Syntara'.
# NOTE: Must match VITE_APP_TITLE below — backend and frontend each read
# their own variable; there is no cross-env sync.
# APP_PRODUCT_NAME=Syntara

# Optional display title — only applied when VITE_EXTENDED=true|1.
# Community builds always show "Syntara" regardless of this value.
# VITE_APP_TITLE=<custom title>
