FROM registry.access.redhat.com/ubi9/python-312:9.5@sha256:306e4320c559d67c60874e3bb85c9f84afc84b66c350b3d4afe0abd65201d6e6

# Switch to root to install dependencies
USER root

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install uv for fast dependency management
RUN pip install --no-cache-dir uv

# Set working directory
WORKDIR /opt/app-root

# Install only FastMCP dependency needed for MCP server
RUN uv init --no-readme --no-workspace --python 3.12
RUN uv add "fastmcp>=3.2.0,<4.0.0" "structlog>=25.5.0"

# Install orchestrator-test-sdk (provides ExampleMCPServer); --no-deps avoids pulling
# syntara-api-client and pytest into the image since only stdlib + fastmcp are needed.
COPY test-sdk/ ./test-sdk/
RUN VIRTUAL_ENV=/opt/app-root/.venv uv pip install --no-cache-dir --no-deps ./test-sdk/

# Copy specific files needed for MCP server
COPY tools/run_mcp_server.py .
COPY tools/run_mcp_scenario_servers.py .

# Fix permissions for OpenShift/UBI (runs as arbitrary UID)
RUN chown -R 1001:0 /opt/app-root && \
    chmod -R g=u /opt/app-root

# Switch back to non-root user (UBI default user)
USER 1001

# OCI container labels
LABEL io.orchestrator.description="Orchestrator MCP development and testing server" \
      io.orchestrator.use-case="development" \
      io.orchestrator.mcp-protocol-version="2025-03-26"

# Expose MCP server port
EXPOSE 8765

# Default command runs the MCP server
CMD ["sh", "-c", "uv run python run_mcp_server.py"]
