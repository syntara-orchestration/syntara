{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.example.com/schemas/workflows/v2/workflow_definition",
  "title": "Workflow Definition Schema v2",
  "description": "JSON Schema for graph-based workflow definitions in the Orchestrator Workflow Engine v2",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "triggers",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "description": "Schema version that this workflow definition conforms to"
    },
    "name": {
      "type": "string",
      "description": "Workflow name",
      "minLength": 1,
      "maxLength": 255
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Human-readable description of the workflow's purpose",
      "minLength": 1,
      "maxLength": 1000
    },
    "triggers": {
      "type": "array",
      "description": "Trigger nodes that define how the workflow is initiated. Must contain at least one trigger. Trigger nodes must be graph entry points (no incoming edges) \u2014 enforced by application-level validation.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/trigger_node"
      }
    },
    "nodes": {
      "type": "array",
      "description": "Execution and control nodes in the workflow graph",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "description": "List of directed edges connecting triggers and nodes in the workflow graph",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node_base": {
      "type": "object",
      "description": "Base node properties shared by all node types",
      "unevaluatedProperties": false,
      "required": [
        "id",
        "type",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the node within the workflow",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable name for the node (display only)",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the node purpose",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "description": "Node type identifier"
        },
        "parameters": {
          "type": "object",
          "description": "Node-specific parameters - see individual node type schemas for details"
        },
        "settings": {
          "type": "object",
          "description": "Optional node-level execution settings. Specific validation delegated to node-type schemas via allOf."
        },
        "outputs": {
          "type": "object",
          "description": "Output extraction mapping (optional - defaults to full result). Reserved field names 'status' and 'error' cannot be used.",
          "patternProperties": {
            "^(?!status$|error$)[a-zA-Z_][a-zA-Z0-9_]*$": {
              "type": "string",
              "description": "Template expression to extract output value"
            }
          },
          "additionalProperties": false,
          "examples": [
            {
              "job_id": "${result.job_id}",
              "job_status": "${result.job_status}"
            },
            {
              "first_server": "${result.artifacts.servers[0]}",
              "second_server": "${result.artifacts.servers[1]}"
            },
            {
              "summary": "${result.output.summary}",
              "priority": "${result.output.priority}"
            }
          ]
        },
        "position": {
          "type": "object",
          "description": "Optional UI position hint for this node. Ignored by the workflow engine.",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      }
    },
    "trigger_node": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "manual_trigger"
                },
                "parameters": {
                  "$ref": "triggers/manual.schema.json#/parameterSchema"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "webhook_trigger"
                },
                "parameters": {
                  "$ref": "triggers/webhook.schema.json#/parameterSchema"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "eda_trigger"
                },
                "parameters": {
                  "$ref": "triggers/eda.schema.json#/parameterSchema"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "scheduled_trigger"
                },
                "parameters": {
                  "$ref": "triggers/scheduled.schema.json#/parameterSchema"
                }
              }
            }
          ]
        }
      ]
    },
    "node": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "aap_job_template"
                },
                "parameters": {
                  "$ref": "executors/aap_job_template.schema.json#/parameterSchema"
                },
                "settings": {
                  "$ref": "common-definitions.schema.json#/$defs/nodeSettingsFull"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "aap_workflow_job_template"
                },
                "parameters": {
                  "$ref": "executors/aap_workflow_job_template.schema.json#/parameterSchema"
                },
                "settings": {
                  "$ref": "common-definitions.schema.json#/$defs/nodeSettingsFull"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "http_request"
                },
                "parameters": {
                  "$ref": "executors/http_request.schema.json#/parameterSchema"
                },
                "settings": {
                  "$ref": "common-definitions.schema.json#/$defs/nodeSettingsFull"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "agentic"
                },
                "parameters": {
                  "$ref": "executors/agentic.schema.json#/parameterSchema"
                },
                "settings": {
                  "$ref": "common-definitions.schema.json#/$defs/nodeSettingsNoRetry"
                }
              }
            }
          ]
        },
        {
          "$comment": "TEMPORARY: Script node added for initial testing only",
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "script"
                },
                "parameters": {
                  "$ref": "executors/script.schema.json#/parameterSchema"
                },
                "settings": {
                  "$ref": "common-definitions.schema.json#/$defs/nodeSettingsNoRetry"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "approval"
                },
                "parameters": {
                  "$ref": "executors/approval.schema.json#/parameterSchema"
                },
                "settings": {
                  "$ref": "common-definitions.schema.json#/$defs/nodeSettingsNoRetry"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "internal_activity"
                },
                "parameters": {
                  "$ref": "executors/internal_activity.schema.json#/parameterSchema"
                },
                "settings": {
                  "$ref": "common-definitions.schema.json#/$defs/nodeSettingsFull"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "condition"
                },
                "parameters": {
                  "$ref": "control-nodes/condition.schema.json#/parameterSchema"
                },
                "settings": {
                  "type": "object",
                  "additionalProperties": false
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "loop"
                },
                "parameters": {
                  "$ref": "control-nodes/loop.schema.json#/parameterSchema"
                },
                "settings": {
                  "$ref": "common-definitions.schema.json#/$defs/nodeSettingsCof"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "converge"
                },
                "parameters": {
                  "$ref": "control-nodes/converge.schema.json#/parameterSchema"
                },
                "settings": {
                  "$ref": "common-definitions.schema.json#/$defs/nodeSettingsCof"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "switch"
                },
                "parameters": {
                  "$ref": "control-nodes/switch.schema.json#/parameterSchema"
                },
                "settings": {
                  "type": "object",
                  "additionalProperties": false
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "wait"
                },
                "parameters": {
                  "$ref": "control-nodes/wait.schema.json#/parameterSchema"
                },
                "settings": {
                  "$ref": "common-definitions.schema.json#/$defs/nodeSettingsCof"
                }
              }
            }
          ]
        }
      ]
    },
    "edge": {
      "type": "object",
      "description": "Edge connecting two nodes or a trigger and a node",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "description": "Source node or trigger ID",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "to": {
          "type": "string",
          "description": "Target node ID (triggers cannot be edge targets)",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "from_port": {
          "type": "string",
          "description": "Output port on the source. Required for multi-output nodes (condition, loop, switch, approval) to specify which execution path this edge represents. Condition nodes use 'true'/'false', loop nodes use 'iterate'/'complete', switch nodes use dynamic case port names, approval nodes use 'approved'/'rejected' (at least one successor on the 'approved' port is required). Port-to-node-type consistency is enforced at the application level.",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "to_port": {
          "type": "string",
          "description": "Input port on the target node. Used to distinguish how an edge arrives at a node.",
          "oneOf": [
            {
              "const": "iterate",
              "description": "Loop input port: feedback edge from the loop body that routes output back to the loop node for the next iteration."
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
