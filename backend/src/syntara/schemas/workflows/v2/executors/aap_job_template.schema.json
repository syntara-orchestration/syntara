{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.example.com/schemas/workflows/v2/executors/aap_job_template",
  "title": "Ansible Automation Platform Job Template Node",
  "description": "Launch Ansible Automation Platform job templates",
  "parameterSchema": {
    "type": "object",
    "description": "Job template must be specified by ID or name. When both are provided, ID takes precedence.",
    "properties": {
      "credential_id": {
        "$ref": "../common-definitions.schema.json#/$defs/credential_id"
      },
      "integration_id": {
        "type": "string",
        "format": "uuid",
        "description": "UUID of the Ansible Automation Platform Gateway integration for connection URL resolution"
      },
      "job_template_id": {
        "type": "integer",
        "description": "Ansible Automation Platform job template ID to launch (takes precedence over name)",
        "minimum": 1
      },
      "job_template_name": {
        "type": "string",
        "description": "Ansible Automation Platform job template name (requires organization_name)",
        "minLength": 1
      },
      "organization_name": {
        "type": "string",
        "description": "Ansible Automation Platform organization name (required with name-based lookup)",
        "minLength": 1
      },
      "organization_id": {
        "type": "integer",
        "description": "Ansible Automation Platform organization ID (takes precedence over organization_name)",
        "minimum": 1
      },
      "inventory_id": {
        "type": "integer",
        "description": "Override default inventory by ID",
        "minimum": 1
      },
      "inventory_name": {
        "type": "string",
        "description": "Override default inventory by name (requires organization_name)",
        "minLength": 1
      },
      "job_credentials": {
        "type": "array",
        "description": "List of Ansible Automation Platform credential IDs to pass to the job template (overrides template defaults)",
        "items": {
          "type": "integer",
          "minimum": 1
        }
      },
      "credential_names": {
        "type": "array",
        "description": "List of Ansible Automation Platform credential names to use (requires organization_name, resolved at launch time)",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "extra_vars": {
        "type": "object",
        "description": "Extra variables to pass to the job (supports templating)",
        "additionalProperties": true
      },
      "limit": {
        "type": "string",
        "description": "Limit job execution to specific hosts"
      },
      "tags": {
        "type": "string",
        "description": "Ansible tags to run (comma-separated)"
      },
      "skip_tags": {
        "type": "string",
        "description": "Ansible tags to skip (comma-separated)"
      },
      "verbosity": {
        "type": "integer",
        "description": "Job verbosity level (0-5)",
        "minimum": 0,
        "maximum": 5,
        "default": 0
      },
      "timeout": {
        "type": "integer",
        "description": "Timeout for job execution in seconds",
        "minimum": 1
      },
      "job_type": {
        "type": "string",
        "description": "Job type override: 'run' or 'check' (dry run)",
        "enum": [
          "run",
          "check"
        ]
      },
      "forks": {
        "type": "integer",
        "description": "Number of parallel forks for job execution",
        "minimum": 0
      },
      "job_slicing": {
        "type": "integer",
        "description": "Number of job slices",
        "minimum": 1
      },
      "diff_mode": {
        "type": "boolean",
        "description": "Enable diff mode for playbook runs"
      },
      "execution_environment": {
        "type": "string",
        "description": "Execution environment override (deferred \u2014 requires ID resolution)"
      },
      "instance_group_id": {
        "type": "integer",
        "description": "Override instance group by ID (takes precedence over instance_group_name)",
        "minimum": 1
      },
      "instance_group_name": {
        "type": "string",
        "description": "Override instance group by name (requires organization_name for lookup)",
        "minLength": 1
      },
      "labels": {
        "type": "array",
        "description": "Ansible Automation Platform label names to append to job template's default labels (resolved to IDs at launch time)",
        "items": {
          "type": "string"
        }
      }
    },
    "anyOf": [
      {
        "required": [
          "job_template_id"
        ]
      },
      {
        "required": [
          "job_template_name",
          "organization_name"
        ]
      }
    ],
    "allOf": [
      {
        "if": {
          "required": [
            "inventory_name"
          ]
        },
        "then": {
          "required": [
            "organization_name"
          ]
        }
      },
      {
        "if": {
          "required": [
            "instance_group_name"
          ]
        },
        "then": {
          "required": [
            "organization_name"
          ]
        }
      }
    ],
    "additionalProperties": false
  },
  "settingSchema": {
    "$ref": "../common-definitions.schema.json#/$defs/nodeSettingsFull"
  },
  "resultSchema": {
    "description": "Result structure available in result namespace (discriminated union)",
    "oneOf": [
      {
        "title": "Completed Result",
        "type": "object",
        "required": [
          "status",
          "job_id",
          "job_status",
          "created",
          "started",
          "finished"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "completed",
            "description": "Execution succeeded"
          },
          "job_id": {
            "type": "integer",
            "description": "Ansible Automation Platform job ID"
          },
          "job_url": {
            "type": "string",
            "description": "URL to view job in Ansible Automation Platform UI"
          },
          "job_status": {
            "type": "string",
            "description": "Job status (successful, failed, etc.)"
          },
          "artifacts": {
            "type": "object",
            "description": "Job artifacts/facts",
            "additionalProperties": true
          },
          "created": {
            "type": "string",
            "description": "Job creation timestamp (ISO 8601)"
          },
          "started": {
            "type": "string",
            "description": "Job start timestamp (ISO 8601)"
          },
          "finished": {
            "type": "string",
            "description": "Job finish timestamp (ISO 8601)"
          }
        },
        "additionalProperties": false
      },
      {
        "title": "Failed Result",
        "type": "object",
        "required": [
          "status",
          "error",
          "job_id",
          "job_status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "failed"
          },
          "error": {
            "type": "string"
          },
          "job_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "job_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "URL to view job in Ansible Automation Platform UI"
          },
          "job_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifacts": {
            "type": [
              "object",
              "null"
            ]
          },
          "created": {
            "type": [
              "string",
              "null"
            ]
          },
          "started": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "description": "All executor fields are present but nullable. A null value means the failure occurred before that field was available."
      }
    ],
    "discriminator": {
      "propertyName": "status"
    }
  }
}
