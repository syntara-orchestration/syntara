{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.example.com/schemas/workflows/v2/executors/tfe_assign_team_permissions",
  "title": "Assign Team Permissions Node",
  "description": "Assign team permissions on a project",
  "parameterSchema": {
    "type": "object",
    "required": [
      "integration_id",
      "credential_id",
      "project_id",
      "team_id",
      "access"
    ],
    "additionalProperties": false,
    "properties": {
      "integration_id": {
        "type": "string"
      },
      "credential_id": {
        "type": "string"
      },
      "project_id": {
        "type": "string"
      },
      "team_id": {
        "type": "string"
      },
      "access": {
        "type": "string",
        "enum": [
          "read",
          "write",
          "maintain",
          "admin",
          "custom"
        ]
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "project_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "team_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "access": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
