{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.example.com/schemas/workflows/v2/executors/tfe_update_variable",
  "title": "Update Variable Node",
  "description": "Update a workspace variable",
  "parameterSchema": {
    "type": "object",
    "required": [
      "integration_id",
      "credential_id",
      "workspace_id",
      "variable_id"
    ],
    "additionalProperties": false,
    "properties": {
      "integration_id": {
        "type": "string"
      },
      "credential_id": {
        "type": "string"
      },
      "organization": {
        "type": ["string", "null"]
      },
      "variable_id": {
        "type": "string"
      },
      "value": {
        "type": ["string", "null"],
        "description": "Plaintext value (non-sensitive only). Use value_credential_id when sensitive=true."
      },
      "value_credential_id": {
        "type": ["string", "null"],
        "description": "UUID of a Secret String credential providing the variable value"
      },
      "sensitive": {
        "type": "boolean"
      },
      "hcl": {
        "type": "boolean"
      },
      "category": {
        "type": "string",
        "enum": [
          "terraform",
          "env"
        ]
      },
      "workspace_id": {
        "type": "string"
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "variable_id": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
