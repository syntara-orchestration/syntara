{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.example.com/schemas/workflows/v2/executors/script_bash",
  "title": "Bash Script Node",
  "description": "Execute Bash code in the isolated Bash script container.",
  "parameterSchema": {
    "type": "object",
    "required": ["code"],
    "properties": {
      "execution_profile": {
        "anyOf": [
          {
            "oneOf": [
              {
                "title": "ExecutionTargetProfile",
                "type": "object",
                "required": ["type", "execution_target_id"],
                "properties": {
                  "type": {"const": "execution_target"},
                  "execution_target_id": {"type": "string", "format": "uuid"}
                },
                "additionalProperties": false
              }
            ],
            "discriminator": {"propertyName": "type"}
          },
          {"type": "null"}
        ],
        "description": "Execution Plane placement profile for this workload.",
        "default": null
      },
      "code": {
        "type": "string",
        "description": "Bash source code to execute.",
        "minLength": 1
      },
      "environment": {
        "type": "object",
        "description": "Environment variables passed to the Bash process.",
        "additionalProperties": {"type": "string"}
      },
      "credential_bindings": {
        "$ref": "../common-definitions.schema.json#/$defs/credential_bindings"
      }
    },
    "additionalProperties": false
  },
  "settingSchema": {
    "$ref": "../common-definitions.schema.json#/$defs/nodeSettingsNoRetry"
  },
  "resultSchema": {
    "$ref": "script_result.schema.json#/resultSchema"
  }
}
