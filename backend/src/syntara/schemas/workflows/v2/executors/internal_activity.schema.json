{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.example.com/schemas/workflows/v2/executors/internal_activity",
  "title": "Internal Activity Node",
  "description": "Execute built-in system operations (document conversion, invocation execution, integration health check, integration resource discovery) as native Temporal activities",
  "parameterSchema": {
    "type": "object",
    "required": [
      "activity"
    ],
    "properties": {
      "activity": {
        "type": "string",
        "enum": [
          "document_conversion",
          "invocation_execution",
          "integration_health_check",
          "integration_resource_discovery"
        ],
        "description": "Internal operation to execute"
      },
      "input": {
        "type": "object",
        "description": "Input parameters for the internal operation",
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  },
  "settingSchema": {
    "$ref": "../common-definitions.schema.json#/$defs/nodeSettingsFull"
  },
  "resultSchema": {
    "type": "object",
    "required": [
      "status"
    ],
    "properties": {
      "status": {
        "type": "string",
        "description": "Operation result status"
      }
    },
    "additionalProperties": true
  }
}
