{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.example.com/schemas/workflows/v2/executors/approval",
  "title": "Approval Node",
  "description": "Human approval gate that pauses workflow execution until approved or rejected",
  "parameterSchema": {
    "type": "object",
    "properties": {
      "credential_id": {
        "$ref": "../common-definitions.schema.json#/$defs/credential_id"
      },
      "approver_users": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 100,
        "description": "List of usernames who can approve this request. Leave empty to allow any user with approval:decide permission."
      },
      "approver_groups": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 50,
        "description": "List of group names whose members can approve this request. Leave empty to allow any user with approval:decide permission."
      },
      "prompt": {
        "type": "string",
        "description": "Message to display to approvers when requesting approval."
      },
      "fallback_decision": {
        "type": "string",
        "enum": [
          "approve",
          "reject"
        ],
        "default": "reject",
        "description": "Decision to apply when the approval cannot complete for any reason and continue_on_failure is true. Defaults to 'reject'."
      },
      "decision_window": {
        "type": "integer",
        "minimum": 1,
        "description": "How long (in seconds) the approver has to respond before the approval expires. Falls back to the system-configured default if not specified."
      }
    },
    "additionalProperties": false
  },
  "settingSchema": {
    "$ref": "../common-definitions.schema.json#/$defs/nodeSettingsNoRetry"
  },
  "resultSchema": {
    "description": "Result structure available after approval decision is made",
    "oneOf": [
      {
        "title": "Completed Result",
        "type": "object",
        "required": [
          "status",
          "decided_by",
          "decision",
          "decided_at"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "completed",
            "description": "Approval decision was made"
          },
          "decided_by": {
            "type": "string",
            "description": "Username of the user who made the decision (or 'system' for timeout/cancellation)"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected",
              "expired",
              "cancelled"
            ],
            "description": "Detailed decision outcome"
          },
          "decided_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the decision occurred (ISO 8601)"
          },
          "decision_notes": {
            "type": "string",
            "description": "Optional notes provided by approver or system (e.g., 'Auto-rejected due to timeout')"
          }
        },
        "additionalProperties": false
      },
      {
        "title": "Failed Result",
        "type": "object",
        "required": [
          "status",
          "error"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "failed"
          },
          "error": {
            "type": "string"
          },
          "decided_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision": {
            "type": [
              "string",
              "null"
            ]
          },
          "decided_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision_notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "description": "All executor fields are present but nullable. A null value means the failure occurred before that field was available."
      }
    ],
    "discriminator": {
      "propertyName": "status"
    }
  }
}
