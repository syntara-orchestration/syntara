{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.example.com/schemas/workflows/v2/executors/tfe_list_workspaces",
  "title": "List Workspaces Node",
  "description": "List Terraform Enterprise workspaces",
  "parameterSchema": {
    "type": "object",
    "required": [
      "integration_id",
      "credential_id"
    ],
    "additionalProperties": false,
    "properties": {
      "integration_id": {
        "type": "string"
      },
      "credential_id": {
        "type": "string"
      },
      "organization": {
        "type": [
          "string",
          "null"
        ],
        "description": "Optional organization override; defaults to the integration organization"
      },
      "search": {
        "type": "string"
      },
      "project_id": {
        "type": "string"
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "workspaces": {
        "type": [
          "array",
          "null"
        ]
      },
      "count": {
        "type": [
          "integer",
          "null"
        ]
      }
    }
  }
}
