{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.example.com/schemas/workflows/v2/executors/tfe_delete_workspace",
  "title": "Delete Workspace Node",
  "description": "Delete a Terraform Enterprise workspace",
  "parameterSchema": {
    "type": "object",
    "required": [
      "integration_id",
      "credential_id",
      "workspace_id"
    ],
    "additionalProperties": false,
    "properties": {
      "integration_id": {
        "type": "string"
      },
      "credential_id": {
        "type": "string"
      },
      "organization": {
        "type": [
          "string",
          "null"
        ],
        "description": "Optional organization override; defaults to the integration organization"
      },
      "workspace_id": {
        "type": "string"
      },
      "force": {
        "type": "boolean",
        "default": false
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "deleted": {
        "type": [
          "boolean",
          "null"
        ]
      }
    }
  }
}
