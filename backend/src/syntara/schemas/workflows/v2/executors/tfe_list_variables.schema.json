{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.example.com/schemas/workflows/v2/executors/tfe_list_variables",
  "title": "List Variables Node",
  "description": "List workspace variables (values never returned)",
  "parameterSchema": {
    "type": "object",
    "required": [
      "integration_id",
      "credential_id",
      "workspace_id"
    ],
    "additionalProperties": false,
    "properties": {
      "integration_id": {
        "type": "string"
      },
      "credential_id": {
        "type": "string"
      },
      "workspace_id": {
        "type": "string"
      },
      "key": {
        "type": "string"
      }
    }
  },
  "resultSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "variables": {
        "type": [
          "array",
          "null"
        ]
      },
      "count": {
        "type": [
          "integer",
          "null"
        ]
      }
    }
  }
}
