{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.example.com/schemas/workflows/v2/executors/script",
  "title": "Script Node",
  "description": "Execute scripts in various languages (TEMPORARY - added for initial testing)",
  "parameterSchema": {
    "type": "object",
    "required": [
      "language",
      "code"
    ],
    "properties": {
      "language": {
        "type": "string",
        "enum": [
          "python",
          "bash"
        ],
        "description": "Script language/runtime"
      },
      "code": {
        "type": "string",
        "description": "Script code to execute",
        "minLength": 1
      },
      "credential_id": {
        "$ref": "../common-definitions.schema.json#/$defs/credential_id"
      },
      "environment": {
        "type": "object",
        "description": "Environment variables to set during script execution",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  },
  "settingSchema": {
    "$ref": "../common-definitions.schema.json#/$defs/nodeSettingsNoRetry"
  },
  "resultSchema": {
    "description": "Result structure available in result namespace (discriminated union)",
    "oneOf": [
      {
        "title": "Completed Result",
        "type": "object",
        "required": [
          "status",
          "return_code",
          "stdout",
          "stderr"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "completed",
            "description": "Script execution completed"
          },
          "return_code": {
            "type": "integer",
            "description": "Script exit code (0 = success)"
          },
          "stdout": {
            "type": "string",
            "description": "Standard output from script execution"
          },
          "stderr": {
            "type": "string",
            "description": "Standard error from script execution"
          },
          "stdout_json": {
            "description": "Parsed JSON from stdout (Python scripts only). Present if stdout contains valid JSON (entire stdout or last line)."
          }
        },
        "additionalProperties": false
      },
      {
        "title": "Failed Result",
        "type": "object",
        "required": [
          "status",
          "error",
          "return_code",
          "stdout",
          "stderr"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "failed"
          },
          "error": {
            "type": "string"
          },
          "return_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "stdout": {
            "type": [
              "string",
              "null"
            ]
          },
          "stderr": {
            "type": [
              "string",
              "null"
            ]
          },
          "stdout_json": {}
        },
        "additionalProperties": false,
        "description": "All executor fields are present but nullable. A null value means the failure occurred before that field was available."
      }
    ],
    "discriminator": {
      "propertyName": "status"
    }
  }
}
