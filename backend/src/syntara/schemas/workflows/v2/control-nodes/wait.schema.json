{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.example.com/schemas/workflows/v2/control-nodes/wait",
  "title": "Wait Node",
  "description": "Pause workflow execution for a specified duration in seconds.",
  "parameterSchema": {
    "type": "object",
    "required": [
      "duration"
    ],
    "properties": {
      "duration": {
        "type": "integer",
        "minimum": 1,
        "description": "Total wait duration in seconds"
      }
    },
    "additionalProperties": false
  },
  "settingSchema": {
    "type": "object",
    "description": "Settings with disabled and continue_on_failure (wait).",
    "properties": {
      "disabled": {
        "type": "boolean",
        "description": "When true, the node is skipped during execution. Downstream nodes still execute but receive no output from this node."
      },
      "continue_on_failure": {
        "type": "boolean",
        "description": "When true, downstream nodes continue executing even if this node fails. Inherits from global settings when absent."
      }
    },
    "additionalProperties": false
  },
  "resultSchema": {
    "description": "Result structure available in result namespace",
    "oneOf": [
      {
        "title": "Completed Result",
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "completed",
            "description": "Wait duration elapsed successfully"
          }
        },
        "additionalProperties": false
      },
      {
        "title": "Failed Result",
        "type": "object",
        "required": [
          "status",
          "error"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "failed"
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "All executor fields are present but nullable. A null value means the failure occurred before that field was available."
      }
    ],
    "discriminator": {
      "propertyName": "status"
    }
  }
}
