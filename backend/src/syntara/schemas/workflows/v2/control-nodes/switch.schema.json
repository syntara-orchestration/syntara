{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.example.com/schemas/workflows/v2/control-nodes/switch",
  "title": "Switch Node",
  "description": "Multi-case expression-based branching",
  "parameterSchema": {
    "type": "object",
    "required": [
      "cases"
    ],
    "properties": {
      "cases": {
        "type": "array",
        "description": "Ordered list of cases, each with its own boolean condition",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "port",
            "label",
            "condition"
          ],
          "properties": {
            "port": {
              "type": "string",
              "description": "Port identifier for this case (e.g. case_0, case_1)",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "description": "Display label for this case",
              "minLength": 1
            },
            "condition": {
              "type": "string",
              "description": "Boolean expression to evaluate. Supports complex expressions with and/or/not operators (empty strings are silently skipped)",
              "examples": [
                "${trigger.status} == \"approved\"",
                "${previous_node.priority} > 5",
                "\"critical\" in ${trigger.tags}",
                "${trigger.priority} > 7 and ${trigger.approved} == True",
                "${trigger.tier} == \"vip\" or ${trigger.tier} == \"premium\"",
                "(${trigger.priority} > 5 and ${trigger.approved} == True) or ${trigger.is_admin} == True",
                "not (${trigger.status} == \"blocked\" and ${trigger.retries} > 3)"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "default_port": {
        "type": "string",
        "description": "Port to route to when no case matches",
        "default": "default"
      }
    },
    "additionalProperties": false
  },
  "settingSchema": {
    "type": "object",
    "description": "Switch nodes have no user-configurable settings. A fixed internal timeout applies.",
    "properties": {},
    "additionalProperties": false
  },
  "resultSchema": {
    "description": "Result structure available in result namespace (discriminated union)",
    "oneOf": [
      {
        "title": "Completed Result",
        "type": "object",
        "required": [
          "status",
          "matched_port"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "completed",
            "description": "Switch evaluated successfully"
          },
          "matched_port": {
            "type": "string",
            "description": "Port that was selected for routing"
          }
        },
        "additionalProperties": false
      },
      {
        "title": "Failed Result",
        "type": "object",
        "required": [
          "status",
          "error"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "failed"
          },
          "error": {
            "type": "string"
          },
          "matched_port": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "description": "All executor fields are present but nullable. A null value means the failure occurred before that field was available."
      }
    ],
    "discriminator": {
      "propertyName": "status"
    }
  }
}
