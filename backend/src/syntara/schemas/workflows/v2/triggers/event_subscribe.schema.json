{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.example.com/schemas/workflows/v2/triggers/event_subscribe.schema.json",
  "title": "Event Subscribe Trigger Node",
  "description": "Workflow entry point receiving events from a managed subscription. The transport (Kafka, \u2026) is determined by the referenced Integration; transport-specific topic rules are enforced server-side.",
  "parameterSchema": {
    "type": "object",
    "required": [
      "integration_id",
      "credential_id",
      "topic"
    ],
    "properties": {
      "integration_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      },
      "credential_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      },
      "topic": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "description": "Topic/subject to subscribe to. Transport-specific naming rules (e.g. Kafka's charset and length limits) are enforced against the resolved Integration."
      },
      "start": {
        "$ref": "#/$defs/kafka_start_configuration",
        "description": "Optional Kafka reading policies. Saved positions take precedence over new starting choices."
      },
      "group_id": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[a-zA-Z0-9._-]+$",
        "default": null,
        "description": "Optional Kafka consumer group. Omitted or null generates a group for a new source and preserves the existing group on same-source republish. Fixed after the first successful publication."
      },
      "input_schema": {
        "type": [
          "object",
          "null"
        ],
        "description": "Optional self-contained JSON Schema (Draft-07) for the event payload.",
        "additionalProperties": true
      },
      "filter": {
        "description": "Optional complete CEL expression; no implicit conditions are added.",
        "anyOf": [
          {
            "$ref": "#/$defs/filter_configuration"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "additionalProperties": false
  },
  "$defs": {
    "kafka_start_configuration": {
      "type": "object",
      "properties": {
        "position": {
          "type": "string",
          "enum": [
            "latest",
            "earliest"
          ],
          "default": "latest"
        },
        "added_partition_position": {
          "type": "string",
          "enum": [
            "latest",
            "earliest"
          ],
          "default": "earliest"
        },
        "offset_gap_policy": {
          "type": "string",
          "enum": [
            "fail",
            "earliest",
            "latest"
          ],
          "default": "earliest"
        }
      },
      "additionalProperties": false
    },
    "filter_configuration": {
      "type": "object",
      "required": [
        "expression"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "maxLength": 16384
        }
      },
      "additionalProperties": false
    }
  },
  "resultSchema": {
    "type": "object",
    "description": "The supplied transport-neutral event envelope after ordinary output mapping.",
    "additionalProperties": true
  }
}
