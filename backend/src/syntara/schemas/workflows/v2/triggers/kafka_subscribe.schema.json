{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.example.com/schemas/workflows/v2/triggers/kafka_subscribe.schema.json",
  "title": "Kafka Subscribe Parameters",
  "parameterSchema": {
    "allOf": [
      {"$ref": "event_subscribe.schema.json#/parameterSchema"},
      {
        "type": "object",
        "required": ["topic"],
        "properties": {
          "transport": {"const": "kafka"},
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 249,
            "pattern": "^[a-zA-Z0-9._-]+$",
            "not": {"enum": [".", ".."]}
          }
        }
      }
    ],
    "unevaluatedProperties": false
  },
  "resultSchema": {
    "$ref": "event_subscribe.schema.json#/resultSchema"
  }
}
