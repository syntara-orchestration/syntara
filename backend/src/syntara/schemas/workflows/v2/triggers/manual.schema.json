{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.example.com/schemas/workflows/v2/triggers/manual",
  "title": "Manual Trigger Node",
  "description": "Workflow entry point triggered manually with user-provided inputs",
  "parameterSchema": {
    "type": "object",
    "properties": {
      "input_schema": {
        "type": "object",
        "description": "JSON Schema defining the structure and validation rules for manual trigger inputs",
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  },
  "resultSchema": {
    "description": "Trigger result is the user-provided input data validated against the input_schema",
    "oneOf": [
      {
        "title": "Completed Result",
        "type": "object",
        "description": "Pass-through of user-provided input data",
        "additionalProperties": true
      },
      {
        "title": "Failed Result",
        "type": "object",
        "description": "Trigger failure output for reporting purposes",
        "required": ["status", "error"],
        "properties": {
          "status": {
            "type": "string",
            "const": "failed"
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    ],
    "discriminator": {
      "propertyName": "status"
    }
  }
}
