# Downstream override layer — digest injected by Konflux build-nudge.
# Defaults to scratch (empty, built-in) so builds without --build-arg succeed.
ARG DOWNSTREAM_OVERRIDE=scratch
ARG BRANDING=false
ARG BUILDER_IMAGE=registry.access.redhat.com/ubi9/python-312:latest
ARG CONTAINER_IMAGE_VERSION=""
ARG APP_SEGMENT_WRITE_KEY=""

FROM ${DOWNSTREAM_OVERRIDE} AS override

# ── builder-base: uv + workspace metadata ───────────────────────────────────
# Shared by all builder stages; no heavy build tools here so the EP builder
# stays lean (asyncpg/temporalio ship manylinux wheels — no compilation needed).
FROM ${BUILDER_IMAGE} AS builder-base

USER 0

ENV PYTHON=python3.12 \
    PYO3_PYTHON=python3.12 \
    UV_LOCK_TIMEOUT=1800 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_USE_PEP517=1

WORKDIR /opt/app-root/src

# Install uv if not already present in the builder image.
RUN (command -v uv >/dev/null 2>&1 || pip3.12 install --no-cache-dir uv==0.12.3) \
    && [ -f /usr/local/bin/uv ] || { command -v uv && ln -s "$(command -v uv)" /usr/local/bin/uv; }

# Workspace root metadata and all workspace member sources (shared by both builders).
# execution-plane/ must be present for uv to resolve the full workspace in syntara-builder,
# and it's the only source ep-builder needs.
COPY pyproject.toml uv.lock LICENSE ./
COPY execution-plane/ ./execution-plane/


# ── syntara-builder: regopy (C/C++) + full workspace ────────────────────────
FROM builder-base AS syntara-builder

ARG BRANDING

ENV CMAKE_ARGS="-DBUILD_TESTING:BOOL=OFF -DRUN_NINJA_TEST:BOOL=OFF -DCMakePythonDistributions_ARCHIVE_DOWNLOAD_DIR:PATH=/cachi2/output/deps/generic"

# Build tools required by regopy (C/C++ compiler, cmake, ninja) and its
# setup.py (git).  Not needed by the EP builder.
RUN dnf install --setopt=install_weak_deps=0 --nodocs -y \
        cmake gcc gcc-c++ git libatomic ninja-build \
    && dnf clean all

COPY README.md alembic.ini ./
COPY tools/ci/sanitize_pyproject_for_hermetic.py /usr/local/bin/sanitize_pyproject_for_hermetic.py
COPY src/ ./src/

RUN --mount=from=override,source=/,target=/tmp/override \
    if [ "$BRANDING" = "true" ] && [ -d /tmp/override/backend ]; then \
        cp -r /tmp/override/backend/. src/syntara/; \
    fi

# Hermetic Konflux builds use uv against Hermeto-prefetched sdists.
# Local builds fall through to normal uv sync.
# hadolint ignore=SC2086
RUN if [ -n "${PIP_FIND_LINKS:-}" ]; then \
        python3.12 /usr/local/bin/sanitize_pyproject_for_hermetic.py pyproject.toml && \
        UV_FIND_LINKS="${PIP_FIND_LINKS}" \
        uv lock --offline --no-index --find-links "${PIP_FIND_LINKS}" && \
        uv venv && \
        tar -xzf /cachi2/output/deps/generic/rego-cpp-1.5.1.tar.gz -C /tmp && \
        tar -xzf /cachi2/output/deps/generic/cmake_utils.tar.gz    -C /tmp && \
        tar -xzf /cachi2/output/deps/generic/trieste.tar.gz        -C /tmp && \
        tar -xzf /cachi2/output/deps/generic/snmalloc.tar.gz       -C /tmp && \
        tar -xzf /cachi2/output/deps/generic/cli11.tar.gz          -C /tmp && \
        printf '%s\n' \
          'set(FETCHCONTENT_SOURCE_DIR_CMAKE_UTILS "/tmp/cmake_utils-2bf98b5773ea7282197c823e205547d8c2e323c0" CACHE PATH "" FORCE)' \
          'set(FETCHCONTENT_SOURCE_DIR_TRIESTE "/tmp/Trieste-0920efeecaa0c56c558f5a5c7a0da865595a43b8" CACHE PATH "" FORCE)' \
          'set(FETCHCONTENT_SOURCE_DIR_SNMALLOC "/tmp/snmalloc-526c55bdffa17aae20a9a3d24fe68a7a3b8d9894" CACHE PATH "" FORCE)' \
          'set(FETCHCONTENT_SOURCE_DIR_CLI11 "/tmp/CLI11-4160d259d961cd393fd8d67590a8c7d210207348" CACHE PATH "" FORCE)' \
          'set(FETCHCONTENT_FULLY_DISCONNECTED ON CACHE BOOL "" FORCE)' \
          > /tmp/fc-offline.cmake && \
        sed -i '/^include(FetchContent)$/r /tmp/fc-offline.cmake' /tmp/rego-cpp-1.5.1/CMakeLists.txt && \
        git -C /tmp/rego-cpp-1.5.1 init -b main && \
        git -C /tmp/rego-cpp-1.5.1 add -A && \
        git -c user.email=build@local -c user.name=Build -C /tmp/rego-cpp-1.5.1 commit -q -m src && \
        REGOCPP_REPO=/tmp/rego-cpp-1.5.1 \
        REGOCPP_TAG=main \
        UV_FIND_LINKS="${PIP_FIND_LINKS}" \
        uv sync --frozen --no-dev --no-editable --no-index --find-links "${PIP_FIND_LINKS}" --offline; \
    else \
        uv sync --frozen --no-dev; \
    fi


# ── ep-builder: execution-plane package only ─────────────────────────────────
# syntara and its heavy deps (regopy, LLM libs, etc.) are excluded from this venv.
# execution-plane/ is already present (inherited from builder-base).
FROM builder-base AS ep-builder

RUN uv sync --frozen --no-dev --no-editable --package execution-plane


# ── runtime-base: shared minimal UBI runtime ────────────────────────────────
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest@sha256:8eb2830d0936237fc13a1f2f7e45aecf90d69043380ad167fad0343632937f41 AS runtime-base

USER root

RUN microdnf install --setopt=install_weak_deps=0 --nodocs -y \
        python3.12 \
        python3.12-pip \
    && microdnf clean all

RUN alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1

COPY LICENSE /licenses/LICENSE

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MALLOC_ARENA_MAX=2 \
    MALLOC_TRIM_THRESHOLD_=131072

WORKDIR /opt/app-root/src


# ── execution-plane: EP worker only ─────────────────────────────────────────
FROM runtime-base AS execution-plane

ARG CONTAINER_IMAGE_VERSION=""

COPY --from=ep-builder /opt/app-root/ /opt/app-root/
COPY --from=ep-builder /usr/local/bin/uv /usr/local/bin/uv

ENV PATH="/opt/app-root/src/.venv/bin:/opt/app-root/bin:$PATH" \
    APP_CONTAINER_IMAGE_VERSION="${CONTAINER_IMAGE_VERSION}"

RUN chown -R 1001:0 /opt/app-root && chmod -R g=u /opt/app-root

USER 1001

CMD ["execution-plane-worker"]

LABEL com.redhat.component="ansible-automation-orchestrator-ep-container" \
      name="ansible-automation-platform/automation-orchestrator-execution-plane-rhel9" \
      summary="Ansible Automation Orchestrator Execution Plane Worker" \
      io.k8s.display-name="automation-orchestrator-execution-plane-rhel9" \
      io.k8s.description="Ansible Automation Orchestrator Execution Plane Worker" \
      vendor="Red Hat, Inc."


# ── syntara: API + Temporal workers ─────────────────────────────────────────
FROM runtime-base AS syntara

ARG CONTAINER_IMAGE_VERSION=""
ARG APP_SEGMENT_WRITE_KEY=""

# Extra RPMs needed by regopy (libatomic, openblas) and cryptography (cffi).
RUN microdnf install --setopt=install_weak_deps=0 --nodocs -y \
        libatomic \
        python3.12-cffi \
        openblas-serial \
        libgomp \
    && microdnf clean all

COPY --from=syntara-builder /opt/app-root/ /opt/app-root/
COPY --from=syntara-builder /usr/local/bin/uv /usr/local/bin/uv

ENV PYTHONPATH=/opt/app-root/src/src \
    PATH="/opt/app-root/src/.venv/bin:/opt/app-root/bin:$PATH" \
    APP_CONTAINER_IMAGE_VERSION="${CONTAINER_IMAGE_VERSION}" \
    APP_SEGMENT_WRITE_KEY="${APP_SEGMENT_WRITE_KEY}"

RUN mkdir -p /data/file-uploads /data/audit-exports && \
    chown -R 1001:0 /data/file-uploads /data/audit-exports && \
    chmod -R g=u /data/file-uploads /data/audit-exports

RUN chown -R 1001:0 /opt/app-root && chmod -R g=u /opt/app-root

COPY containers/syntara/scripts/start-api /usr/local/bin/start-api
COPY containers/syntara/scripts/start-worker /usr/local/bin/start-worker
COPY containers/syntara/scripts/start-background-worker /usr/local/bin/start-background-worker
COPY containers/syntara/scripts/run-seed /usr/local/bin/run-seed

RUN python3.12 -c "from zoneinfo import available_timezones; tzs = available_timezones(); assert len(tzs) > 100, f'Expected >100 timezones, got {len(tzs)}'"

USER 1001

EXPOSE 8000

CMD ["start-api"]

ENV DESCRIPTION="Red Hat Ansible Automation Orchestrator" \
    container=oci

LABEL com.redhat.component="ansible-automation-orchestrator-backend-container" \
      name="ansible-automation-platform/automation-orchestrator-backend-rhel9" \
      cpe="cpe:/a:redhat:ansible_automation_orchestrator:2026.8::el9" \
      summary="${DESCRIPTION}" \
      io.openshift.expose-services="8000:http" \
      io.openshift.tags="automation,ansible,orchestrator" \
      io.k8s.display-name="automation-orchestrator-backend-rhel9" \
      io.k8s.description="${DESCRIPTION}" \
      maintainer="Ansible Automation Platform Productization Team" \
      description="${DESCRIPTION}" \
      vendor="Red Hat, Inc."
