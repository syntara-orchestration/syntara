# Syntara Development Environment Configuration
# Copy this file to .env and customize as needed
# DO NOT commit .env to version control
# You can set APP_ENV_FILE_PATH to point to a different .env file if desired

# PostgreSQL Database Configuration
APP_DB_HOST=localhost          # Database server hostname
APP_DB_PORT=5432               # Database server port (change if 5432 conflicts)
APP_DB_USER=admin              # Database username
APP_DB_PASSWORD=admin          # Database password (simple for local development)
APP_DB_NAME=syntara_api          # Initial database name
APP_DB_POOL_SIZE=10            # SQLAlchemy pool: persistent connections
APP_DB_MAX_OVERFLOW=20         # SQLAlchemy pool: extra temporary connections
APP_DB_POOL_TIMEOUT_SECONDS=30 # Seconds to wait for connection before timeout

# Audit Worker Connection Pool (separate from main pool)
# See: backend/docs/audit-performance-optimization.md (Option 1)
APP_AUDIT_WORKER_POOL_SIZE=5   # Audit worker pool: persistent connections (independent of main pool)
APP_AUDIT_WORKER_MAX_OVERFLOW=2 # Audit worker pool: extra temporary connections

# PostgreSQL SSL/TLS Configuration
# APP_DB_SSL_MODE=prefer              # SSL mode: disable, allow, prefer, require, verify-ca, verify-full
# APP_DB_SSL_ROOT_CERT=               # Path to CA certificate for server verification
# APP_DB_SSL_CERT=                    # Path to client certificate (mutual TLS)
# APP_DB_SSL_KEY=                     # Path to client private key (mutual TLS)

# Alternative: Full database URL (overrides ALL individual APP_DB_* settings, including SSL)
# When set, APP_DB_SSL_* fields are ignored — the caller owns all driver/connection semantics.
# APP_DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/syntara_api

# Internal Service-to-Service mTLS Configuration
# Certificates are auto-generated by 'make setup' or 'make certs' into .secrets/certs/
# Enabled by default in podman-compose; disabled for non-compose local dev (make dev)
# APP_S2S_TLS_ENABLED=true
# APP_S2S_TLS_CA_CERT_PATH=.secrets/certs/ca.pem
# APP_S2S_TLS_CERT_PATH=.secrets/certs/backend.crt
# APP_S2S_TLS_KEY_PATH=.secrets/certs/backend.key
# APP_S2S_TLS_CN_ALLOWLIST=["backend.ao.svc","worker.ao.svc"]  # Allowed client cert CNs (JSON array; omit to accept any CA-signed cert)
# APP_S2S_TLS_CRL_PATH=.secrets/certs/crl.pem                        # PEM-encoded CRL for certificate revocation checking

# Temporal Workflow Engine Configuration
APP_TEMPORAL_PORT=7233         # Temporal server port
APP_TEMPORAL_UI_PORT=8081      # Temporal UI web interface port
APP_TEMPORAL_ADDRESS=localhost:7233     # Temporal server address
APP_TEMPORAL_NAMESPACE=default # Temporal namespace
APP_TASK_QUEUE=orchestrator-workflow-queue     # Task queue name for workflow execution
APP_MAX_CONCURRENT_WORKFLOWS=0  # Cap on concurrent non-terminal workflow executions (0 = disabled)

# Podman Compose Configuration
PODMAN_PROJECT=syntara             # Project name for podman-compose (affects container/volume names)
                                 # Change this when working with multiple instances on the same host

# API and Service Ports
APP_API_PORT=8000              # API server port
APP_UI_PORT=8080               # UI server port
APP_CACHE_HOST=localhost            # Cache server hostname
APP_CACHE_PORT=6379                 # Cache server port
APP_CACHE_PASSWORD=cache            # Cache server password (matches podman-compose.yml)

# JWT Authentication Configuration
# Run 'make secrets-generate' to create development keys in .secrets/
APP_JWT_PRIVATE_KEY_PATH=.secrets/jwt-primary.pem  # Path to JWT signing key (generated by make secrets-generate)
APP_JWT_BACKUP_KEYS=[{"key_id":"orchestrator-backup","key_path":".secrets/jwt-backup.pem"}]  # Backup keys for key rotation
APP_ADMIN_PASSWORD_PATH=.secrets/admin-password    # Path to admin password file
APP_SECRET_ENCRYPTION_KEY_PATH=.secrets/encryption-key  # Path to AES-256-GCM encryption key (generated by make secrets-generate)

# Server Configuration
APP_SERVER_SCHEME=http         # URL scheme (http for local dev, https for production; also controls cookie Secure flag)
APP_SERVER_PUBLIC_URL=http://localhost:8000  # Public URL for JWT issuer and redirects (must match how clients reach the API)
APP_CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:8080"]  # Allowed origins for CORS and OIDC redirect validation
# APP_OIDC_ALLOW_PRIVATE_NETWORKS=false  # Allow OIDC providers on private/internal networks (enable for internal IdPs)
# APP_CREDENTIAL_ALLOW_HTTP_HOST=false   # Allow HTTP scheme for credential host URLs (enable for local dev cluster)
# APP_WORKFLOW_HTTP_REQUEST_ALLOWED_HOSTS=[]  # Hostnames workflow HTTP request nodes may target despite resolving to private IPs (JSON array)
# Hostnames whose integration base_url may resolve to private/loopback IPs (JSON array).
# Defaults to [] (empty) — the prod-safe default; leave commented for non-compose deploys.
# Compose and CI set ["mcp-server"] themselves (the bundled test MCP server), so you do not
# need to set this here for `podman-compose up`.
# For host-based `make dev`, allowlist the exact hostname your integration base_url uses:
# "localhost" for http://localhost:8765, or "127.0.0.1" for http://127.0.0.1:8765 — the
# allowlist matches on hostname, so the two are not interchangeable. Loopback is reachable
# over HTTP even with the default allow_http=false.
# APP_INTEGRATION_URL_ALLOWED_HOSTS=[]

# Logging Configuration
APP_FALLBACK_LOG_LEVEL=INFO             # Fallback logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)

# =============================================================================
# Telemetry Configuration (Segment.com)
# =============================================================================

# Telemetry is always enabled per feature definition.
# Workflow execution metrics are transmitted to Segment.com for product analytics.
# No PII or credentials are collected.
# The write key is typically injected at build time via Dockerfile ARG.
# APP_SEGMENT_WRITE_KEY=                    # Segment write API key (write-only, build-time injected)
# APP_SEGMENT_ENDPOINT=https://api.segment.io  # Segment API endpoint URL
# APP_ENTITLEMENT_ID=                       # Unique Syntara installation identifier for anonymized telemetry
# APP_COLLECTION_INTERVAL_SECONDS=300        # Interval in seconds between periodic analytics collection cycles

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# OpenRouter Configuration
# OpenRouter is a third-party service that provides unified API access to multiple LLM providers
# (Claude, GPT-4, Gemini, etc.). LLM credentials are configured on workflow agentic nodes
# via the credential system. These settings provide defaults for model, URL, and parameters.
APP_OPENROUTER_MODEL=anthropic/claude-sonnet-4  # or openai/gpt-4, google/gemini-pro, etc.
APP_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# API Validation and Router Discovery Configuration
# =============================================================================

# OpenAPI Validation
# Enable validation of FastAPI routes against OpenAPI schema specifications.
# This checks that all defined API endpoints match their OpenAPI schemas.
# NOTE: This is NOT related to OpenRouter (the LLM service above).
APP_OPENAPI_VALIDATION_ENABLED=true

# API Documentation Endpoints
# Serve /docs, /redoc, and /openapi.json. Disabled by default for production security.
# Set to true here for local development only — do NOT copy this value to production.
APP_ENABLE_API_DOCS=true
# Enable the Swagger UI "Try it out" button. Defaults to false.
# APP_ENABLE_TRY_IT_OUT=false

# Router Discovery
# Enable automatic router discovery and registration.
# When enabled, routers are automatically discovered from domain directories
# without manual import and registration in main.py.
APP_ROUTER_DISCOVERY_ENABLED=true

# Exclude Modules
# Comma-separated list of module names to exclude from automatic discovery.
# Example: "core,utils,websocket"
APP_ROUTER_EXCLUDE_MODULES=

# =============================================================================
# Workflow Engine Configuration
# =============================================================================

# Script Execution Settings
APP_SCRIPT_CLEANUP_TERMINATE_TIMEOUT=1.0  # Timeout for graceful process termination
APP_SCRIPT_CLEANUP_KILL_TIMEOUT=0.5       # Timeout for forceful process kill
APP_MAX_ENV_VAR_LENGTH=32768              # Maximum length per environment variable (32KB)

# Service-to-Service Communication URLs
# NOTE: These are automatically configured in podman-compose.yml with correct container networking.
# Only uncomment and override if running services outside of containers or for custom deployment scenarios.
# APP_WORKFLOW_BASE_URL=http://localhost:8000/api/v1        # Override workflow engine base URL (default: http://syntara:8000/api/v1 in containers)
# APP_AGENT_ORCHESTRATOR_BASE_URL=http://localhost:8000/api/v1  # Override agent orchestrator API base URL (default: http://syntara:8000/api/v1 in containers)
# APP_APPROVALS_API_BASE_URL=http://localhost:8000/api/v1      # Override approvals API base URL (default: http://syntara:8000/api/v1 in containers)


# =============================================================================
# AAP (Ansible Automation Platform) Configuration
# =============================================================================

# AAP Connection Settings (for AAP Job Template executor)
APP_AAP_BASE_URL=https://aap.example.com     # AAP Controller base URL
APP_AAP_USERNAME=workflow_user               # AAP username (optional if using token)
APP_AAP_PASSWORD=secret_password             # AAP password (optional if using token)
APP_AAP_TOKEN=your_api_token_here            # AAP API token (preferred over username/password)
APP_AAP_VERIFY_SSL=true                      # Verify SSL certificates (set to false for self-signed certs in dev/test)

# AAP Activity Settings
APP_AAP_TIMEOUT_SECONDS=3600                 # Default timeout for AAP job template activities (1 hour)
APP_AAP_POLL_INTERVAL_SECONDS=5.0            # Job status polling interval (AAP recommendation: 5 seconds)
